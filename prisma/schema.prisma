// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WithdrawStatus {
  PENDING   
  APPROVED   
  REJECTED  
}

enum TransactionStatus {
  PENDING 
  COMPLETED    
  FAILED       
  CANCELED   
}

enum PaymentProviderType {
  CARD
  CRYPTO
  WALLET
  BANK
  OTHER
}

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  ROULETTE_BET
  ROULETTE_WIN
  SLOT_BET
  SLOT_WIN
  REFUND
}

enum AuthProvider {
  GOOGLE
  GITHUB
  DISCORD
}

enum BetType {
  NUMBER
  COLOR
  ODD_EVEN
  DOZEN
  COLUMN
  HIGH_LOW
}

enum RoundStatus {
  PENDING
  SPINNING
  FINISHED
}

enum TokenType {
  VERIFICATION
  RESET_PASSWORD
}

model Token {
  id        Int       @id @default(autoincrement())
  email     String
  token     String    @unique
  type      TokenType
  expiresIn DateTime  @map("expires_in")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("tokens")
}

model User {
  id          Int       @id @default(autoincrement()) @map("id")
  username    String    @unique @map("username")
  password    String?   @map("password")
  email       String    @unique @map("email")
  isBanned    Boolean   @default(false) @map("is_banned")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  isVerified  Boolean   @default(false) @map("is_verified")
  banEndAt    DateTime? @map("ban_end_at")
  role        Role      @default(USER)
  lastLoginIP String?   @map("last_login_ip")
  lastLoginAt DateTime  @default(now()) @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  profile      Profile?
  address      Address?
  bets         RouletteBet[]
  gameSessions GameSession[]
  withdrawRequests WithdrawRequest[]
  providers UserProvider[]
  slotRounds SlotRound[]
  
  @@index([email])
  @@index([createdAt])
  @@index([lastLoginIP])
  @@map("users")
}

model UserProvider {
  id         Int          @id @default(autoincrement())
  userId     Int          @map("user_id")
  provider   AuthProvider
  providerId String       @map("provider_id")
  createdAt  DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@unique([userId, provider])
  @@map("user_providers")
}

model Profile {
  userId    Int      @id @map("user_id")
  rating    Int      @default(0) @map("rating")
  stripeCustomerId String? @unique @map("stripe_customer_id")
  balance   Decimal  @default(0) @map("balance") @db.Decimal(18, 6)
  avatar    String?  @map("avatar")
  level     Int      @default(0) @map("level")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@index([level])
  @@index([rating])
  @@map("profiles")
}

model Address {
  userId      Int      @id @map("user_id")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  phoneNumber String   @map("phone_number")
  address     String   @map("address")
  address2    String?  @map("address2")
  country     String?  @map("country")
  postalCode  String   @map("postal_code")
  city        String   @map("city")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([country])
  @@index([city])
  @@map("addresses")
}

model Transaction {
  id            String          @id @default(uuid())
  walletId      Int             @map("wallet_id")
  type          TransactionType
  amount        Decimal         @db.Decimal(18, 2)
  balanceBefore Decimal         @map("balance_before") @db.Decimal(18, 2)
  balanceAfter  Decimal         @map("balance_after") @db.Decimal(18, 2)
  status        TransactionStatus  @default(PENDING) 
  providerId    Int?            @map("provider_id")
  externalId    String?         @unique
  createdAt     DateTime        @default(now()) @map("created_at")

  wallet Profile @relation(fields: [walletId], references: [userId])
  provider PaymentProvider? @relation(fields: [providerId], references: [id])
  withdrawRequest WithdrawRequest?

  @@index([walletId, createdAt(sort: Desc)])
  @@map("transactions")
}

model RouletteRound {
  id            String      @id @default(uuid())
  status        RoundStatus @default(PENDING)
  winningNumber Int?        @map("winning_number")
  winningColor  String?     @map("winning_color")
  gameSessionId String      @unique @map("game_session_id")
  startedAt     DateTime    @default(now()) @map("started_at")
  finishedAt    DateTime?   @map("finished_at")

  gameSession GameSession   @relation(fields: [gameSessionId], references: [id])
  bets        RouletteBet[]

  @@index([status])
  @@index([startedAt(sort: Desc)])
  @@map("roulette_rounds")
}

model RouletteBet {
  id        String   @id @default(uuid())
  roundId   String   @map("round_id")
  userId    Int      @map("user_id")
  betType   BetType  @map("bet_type")
  betValue  String   @map("bet_value")
  amount    Decimal  @db.Decimal(18, 2)
  payout    Decimal? @db.Decimal(18, 2)
  isWin     Boolean? @map("is_win")
  createdAt DateTime @default(now()) @map("created_at")

  round RouletteRound @relation(fields: [roundId], references: [id])
  user  User          @relation(fields: [userId], references: [id])

  @@index([roundId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("roulette_bets")
}

model GameSession {
  id          String    @id @default(cuid())
  userId      Int?      @map("user_id")
  liveRoomId  String?   @map("live_room_id")
  serverSeed  String    @map("server_seed")
  serverHash  String    @map("server_hash")
  clientSeed  String    @default("default-client-seed") @map("client_seed")
  nonce       Int       @default(0)
  isRevealed  Boolean   @default(false) @map("is_revealed")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User?             @relation(fields: [userId], references: [id])
  liveRoom    LiveRouletteRoom? @relation(fields: [liveRoomId], references: [id])
  round       RouletteRound?

  @@map("game_sessions")
}

model WithdrawRequest {
  id        String         @id @default(uuid())
  userId    Int            @map("user_id")
  amount    Decimal        @db.Decimal(18, 2)
  status    WithdrawStatus @default(PENDING)
  cardLast4 String?        @map("card_last4")
  comment   String?        
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  transactionId String? @unique @map("transaction_id")
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("withdraw_requests")
}

model LiveRouletteRoom {
  id        String   @id @default(cuid())
  name      String
  minBet    Decimal  @default(0.01)  @map("min_bet")
  maxBet    Decimal  @default(100000) @map("max_bet")
  isActive  Boolean  @default(true)  @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  sessions  GameSession[]

  @@map("live_roulette_rooms")
}

model PaymentProvider {
  id          Int  @id @default(autoincrement())
  name        String   
  code        String   @unique
  type        PaymentProviderType

  isActive    Boolean  @default(true) @map("is_active")

  transactions Transaction[]

  @@map("payment_providers")
}

model SlotRound {
  id           String   @id @default(uuid())
  userId       Int      @map("user_id")
  grid         Json     @map("grid")           
  winningLines Json     @map("winning_lines")  
  betPerLine   Decimal  @map("bet_per_line")   @db.Decimal(18, 2)
  activeLines  Int      @map("active_lines")
  totalBet     Decimal  @map("total_bet")      @db.Decimal(18, 2)
  totalPayout  Decimal  @map("total_payout")   @db.Decimal(18, 2)
  scatterCount Int      @map("scatter_count")
  isWin        Boolean  @map("is_win")
  createdAt    DateTime @default(now())        @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([isWin])
  @@map("slot_rounds")
}